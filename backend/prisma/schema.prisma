// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

/// Player position on the pitch — maps to FPL's element_type
enum Position {
  GKP
  DEF
  MID
  FWD
}

/// Current status of a league
enum LeagueStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Member state within a competition
enum MembershipStatus {
  PENDING
  ACTIVE
  CANCELLED
  REFUNDED
}

/// Financial lifecycle states for league entry fee payment
enum PaymentStatus {
  PENDING
  PAYMENT_INITIATED
  PAYMENT_SUBMITTED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  REFUND_PENDING
  REFUNDED
}

/// How a league is scored
enum ScoringType {
  CLASSIC
  HEAD_TO_HEAD
}

/// FPL chips a squad can play once per season
enum ChipType {
  TRIPLE_CAPTAIN
  BENCH_BOOST
  FREE_HIT
  WILDCARD
}

/// Role-Based Access Control role assigned to a user account.
/// USER: regular platform consumer (default).
/// MODERATOR: trusted operator able to run operational maintenance (e.g. syncs).
/// ADMIN: full administrative access (platform settings, fee management).
enum UserRole {
  USER
  MODERATOR
  ADMIN
}

/// Types of USDC financial transactions
enum TransactionType {
  ENTRY_FEE
  PLATFORM_FEE
  PRIZE_PAYOUT
  REFUND
}

/// Status of a blockchain transaction
enum TransactionStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

// ============================================================
// MODELS
// ============================================================

/// A registered user on the platform.
/// Laravel equivalent: the `users` table you'd create with `php artisan make:auth`.
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?  @map("password_hash")
  username      String   @unique
  name          String?
  googleId      String?  @unique @map("google_id")
  countryCode   String?  @map("country_code")
  role          UserRole @default(USER)
  referrerId    String?  @map("referrer_id")
  referralCode  String?  @unique @map("referral_code")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  wallet        Wallet?
  squads        Squad[]
  createdLeagues League[]       @relation("LeagueCreator")
  memberships   LeagueMember[]
  transactions  Transaction[]
  referrer      User?          @relation("UserReferrals", fields: [referrerId], references: [id])
  referrees     User[]         @relation("UserReferrals")

  @@map("users")
}

/// A Stellar wallet linked to a user for USDC payments.
/// Optional — users can use the platform without one.
model Wallet {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  stellarAddress String   @unique @map("stellar_address")
  connectedAt    DateTime @default(now()) @map("connected_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

/// A Premier League club. Data synced from the FPL API.
model Team {
  id                  Int     @id @default(autoincrement())
  fplId               Int     @unique @map("fpl_id")
  name                String
  shortName           String  @map("short_name")
  logoUrl             String? @map("logo_url")
  strength            Int?
  strengthOverallHome Int?    @map("strength_overall_home")
  strengthOverallAway Int?    @map("strength_overall_away")
  strengthAttackHome  Int?    @map("strength_attack_home")
  strengthAttackAway  Int?    @map("strength_attack_away")
  strengthDefenceHome Int?    @map("strength_defence_home")
  strengthDefenceAway Int?    @map("strength_defence_away")

  // Relations
  players      Player[]
  homeFixtures Fixture[] @relation("HomeFixtures")
  awayFixtures Fixture[] @relation("AwayFixtures")

  @@map("teams")
}

/// A real Premier League footballer. Data synced from the FPL API.
/// Like an Eloquent model with `$fillable` fields populated from an external API.
model Player {
  id                       Int      @id @default(autoincrement())
  fplId                    Int      @unique @map("fpl_id")
  firstName                String   @map("first_name")
  lastName                 String   @map("last_name")
  displayName              String   @map("display_name")
  position                 Position
  teamId                   Int      @map("team_id")
  price                    Decimal  @db.Decimal(4, 1)
  totalPoints              Int      @default(0) @map("total_points")
  minutesPlayed            Int      @default(0) @map("minutes_played")
  goalsScored              Int      @default(0) @map("goals_scored")
  assists                  Int      @default(0)
  cleanSheets              Int      @default(0) @map("clean_sheets")
  form                     Decimal? @db.Decimal(4, 1)
  status                   String?  @default("a")
  news                     String?
  chanceOfPlayingNextRound Int?     @map("chance_of_playing_next_round")
  selectedByPercent        Decimal? @map("selected_by_percent") @db.Decimal(5, 1)
  photoUrl                 String?  @map("photo_url")
  isAvailable              Boolean  @default(true) @map("is_available")
  updatedAt                DateTime @updatedAt @map("updated_at")

  // Relations
  team          Team                  @relation(fields: [teamId], references: [id])
  squadPlayers  SquadPlayer[]
  gameweekStats PlayerGameweekStats[]
  transfersIn   SquadTransfer[]       @relation("TransferIn")
  transfersOut  SquadTransfer[]       @relation("TransferOut")
  priceChanges  PlayerPriceChange[]
  statusHistory PlayerStatusHistory[]

  @@map("players")
}

/// A round of Premier League matches (38 per season).
model Gameweek {
  id         Int       @id @default(autoincrement())
  fplId      Int       @unique @map("fpl_id")
  name       String
  deadline   DateTime
  isCurrent  Boolean   @default(false) @map("is_current")
  isFinished Boolean   @default(false) @map("is_finished")
  isLocked   Boolean   @default(false) @map("is_locked")
  settledAt  DateTime? @map("settled_at")
  season     String

  // Relations
  fixtures        Fixture[]
  playerStats     PlayerGameweekStats[]
  squadScores     SquadGameweekScore[]
  leaguesStarting League[]              @relation("LeagueStartGW")
  leaguesEnding   League[]              @relation("LeagueEndGW")
  chipUsages      SquadChipUsage[]
  leagueFixtures  LeagueFixture[]
  squadTransfers  SquadTransfer[]

  @@map("gameweeks")
}

/// A Premier League match between two clubs. Data synced from the FPL API.
model Fixture {
  id          Int       @id @default(autoincrement())
  fplId       Int       @unique @map("fpl_id")
  gameweekId  Int?      @map("gameweek_id")
  homeTeamId  Int       @map("home_team_id")
  awayTeamId  Int       @map("away_team_id")
  kickoffTime DateTime? @map("kickoff_time")
  started     Boolean   @default(false)
  finished    Boolean   @default(false)
  homeScore   Int?      @map("home_score")
  awayScore   Int?      @map("away_score")
  minutes     Int       @default(0)

  // Relations
  gameweek Gameweek? @relation(fields: [gameweekId], references: [id])
  homeTeam Team      @relation("HomeFixtures", fields: [homeTeamId], references: [id])
  awayTeam Team      @relation("AwayFixtures", fields: [awayTeamId], references: [id])

  @@map("fixtures")
}

/// How many fantasy points a player scored in a specific gameweek.
/// Like a Laravel pivot table with extra columns.
model PlayerGameweekStats {
  id          Int     @id @default(autoincrement())
  playerId    Int     @map("player_id")
  gameweekId  Int     @map("gameweek_id")
  minutes     Int     @default(0)
  goals       Int     @default(0)
  assists     Int     @default(0)
  cleanSheet  Boolean @default(false) @map("clean_sheet")
  yellowCards Int     @default(0) @map("yellow_cards")
  redCards    Int     @default(0) @map("red_cards")
  saves       Int     @default(0)
  bonus       Int     @default(0)
  totalPoints Int     @default(0) @map("total_points")

  // Relations
  player   Player   @relation(fields: [playerId], references: [id])
  gameweek Gameweek @relation(fields: [gameweekId], references: [id])

  @@unique([playerId, gameweekId])
  @@map("player_gameweek_stats")
}

/// A user's fantasy football squad.
model Squad {
  id                      String   @id @default(uuid())
  userId                  String   @map("user_id")
  name                    String
  budgetRemaining         Decimal  @default(100.0) @map("budget_remaining") @db.Decimal(5, 1)
  totalPoints             Int      @default(0) @map("total_points")
  /// Free transfers left for freeTransfersGameweekId (rolls over +1 per gameweek)
  freeTransfers           Int      @default(1) @map("free_transfers")
  freeTransfersGameweekId Int?     @map("free_transfers_gameweek_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // Relations
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  players        SquadPlayer[]
  gameweekScores SquadGameweekScore[]
  memberships    LeagueMember[]
  chipUsages     SquadChipUsage[]
  squadTransfers SquadTransfer[]

  @@map("squads")
}

/// A player selected in a squad — the join table between Squad and Player.
/// Tracks whether the player is starting, captain, bench order, and purchase price.
model SquadPlayer {
  id            Int     @id @default(autoincrement())
  squadId       String  @map("squad_id")
  playerId      Int     @map("player_id")
  isCaptain     Boolean @default(false) @map("is_captain")
  isViceCaptain Boolean @default(false) @map("is_vice_captain")
  isStarter     Boolean @default(true) @map("is_starter")
  positionOrder Int     @map("position_order")
  purchasePrice Decimal @map("purchase_price") @db.Decimal(4, 1)

  // Relations
  squad  Squad  @relation(fields: [squadId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  @@unique([squadId, playerId])
  @@map("squad_players")
}

/// A fantasy league created by a user.
model League {
  id              String       @id @default(uuid())
  name            String
  description     String?
  creatorId       String       @map("creator_id")
  inviteCode      String       @unique @map("invite_code")
  maxMembers      Int          @default(20) @map("max_members")
  minMembers      Int          @default(2) @map("min_members")
  currentMembers  Int          @default(0) @map("current_members")
  entryFee        Decimal      @default(0) @map("entry_fee") @db.Decimal(10, 2)
  prizePool       Decimal      @default(0) @map("prize_pool") @db.Decimal(10, 2)
  status          LeagueStatus @default(UPCOMING)
  scoringType     ScoringType  @default(CLASSIC) @map("scoring_type")
  startGameweekId Int          @map("start_gameweek_id")
  endGameweekId   Int          @map("end_gameweek_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  creator       User            @relation("LeagueCreator", fields: [creatorId], references: [id])
  startGameweek Gameweek        @relation("LeagueStartGW", fields: [startGameweekId], references: [id])
  endGameweek   Gameweek        @relation("LeagueEndGW", fields: [endGameweekId], references: [id])
  members       LeagueMember[]
  transactions  Transaction[]
  fixtures      LeagueFixture[]

  @@map("leagues")
}

/// A user's membership in a league — links user, squad, and league together.
/// Like a Laravel pivot table: `league_user` with extra columns.
model LeagueMember {
  id             String           @id @default(uuid())
  leagueId       String           @map("league_id")
  userId         String           @map("user_id")
  squadId        String           @map("squad_id")
  status         MembershipStatus @default(PENDING)
  paymentStatus  PaymentStatus    @default(PENDING) @map("payment_status")
  stellarAddress String?          @map("stellar_address")
  joinedAt       DateTime         @default(now()) @map("joined_at")
  hasPaid        Boolean          @default(false) @map("has_paid")
  rank           Int?
  totalPoints    Int              @default(0) @map("total_points")

  // Head-to-head statistics
  matchesWon    Int @default(0) @map("matches_won")
  matchesDrawn  Int @default(0) @map("matches_drawn")
  matchesLost   Int @default(0) @map("matches_lost")
  pointsFor     Int @default(0) @map("points_for")
  pointsAgainst Int @default(0) @map("points_against")
  h2hPoints     Int @default(0) @map("h2h_points")

  // Relations
  league       League          @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id])
  squad        Squad           @relation(fields: [squadId], references: [id])
  transactions Transaction[]
  homeFixtures LeagueFixture[] @relation("HomeLeagueFixtures")
  awayFixtures LeagueFixture[] @relation("AwayLeagueFixtures")

  @@unique([leagueId, userId])
  @@map("league_members")
}

/// How many points a squad scored in a specific gameweek.
model SquadGameweekScore {
  id            Int      @id @default(autoincrement())
  squadId       String   @map("squad_id")
  gameweekId    Int      @map("gameweek_id")
  points        Int      @default(0)
  benchPoints   Int      @default(0) @map("bench_points")
  captainPoints Int      @default(0) @map("captain_points")
  transferCost  Int      @default(0) @map("transfer_cost")
  calculatedAt  DateTime @default(now()) @map("calculated_at")

  // Relations
  squad    Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  gameweek Gameweek @relation(fields: [gameweekId], references: [id])

  @@unique([squadId, gameweekId])
  @@map("squad_gameweek_scores")
}

/// Audit record of a single transfer (one player out, one player in).
model SquadTransfer {
  id          Int      @id @default(autoincrement())
  squadId     String   @map("squad_id")
  gameweekId  Int      @map("gameweek_id")
  playerInId  Int      @map("player_in_id")
  playerOutId Int      @map("player_out_id")
  inPrice     Decimal  @map("in_price") @db.Decimal(4, 1)
  outPrice    Decimal  @map("out_price") @db.Decimal(4, 1)
  pointsCost  Int      @default(0) @map("points_cost")
  timestamp   DateTime @default(now())

  // Relations
  squad     Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  gameweek  Gameweek @relation(fields: [gameweekId], references: [id])
  playerIn  Player   @relation("TransferIn", fields: [playerInId], references: [id])
  playerOut Player   @relation("TransferOut", fields: [playerOutId], references: [id])

  @@index([squadId, gameweekId])
  @@map("squad_transfers")
}

/// Records USDC transactions — entry fees, prizes, deposits, withdrawals.
model Transaction {
  id            String            @id @default(uuid())
  userId        String            @map("user_id")
  leagueId      String?           @map("league_id")
  memberId      String?           @map("member_id")
  type          TransactionType
  amount        Decimal           @db.Decimal(10, 2)
  asset         String            @default("USDC")
  assetIssuer   String?           @map("asset_issuer")
  stellarTxHash String?           @map("stellar_tx_hash")
  ledgerSeq     Int?              @map("ledger_seq")
  memo          String?
  status        TransactionStatus @default(PENDING)
  confirmedAt   DateTime?         @map("confirmed_at")
  errorMessage  String?           @map("error_message")
  createdAt     DateTime          @default(now()) @map("created_at")

  // Relations
  user   User          @relation(fields: [userId], references: [id])
  league League?       @relation(fields: [leagueId], references: [id])
  member LeagueMember? @relation(fields: [memberId], references: [id])

  // A batched refund shares one Stellar hash across several members
  @@unique([stellarTxHash, memberId])
  @@map("transactions")
}

/// A chip played by a squad for a gameweek.
/// Each chip can be used once per season, and only one chip per gameweek.
model SquadChipUsage {
  id             Int       @id @default(autoincrement())
  squadId        String    @map("squad_id")
  gameweekId     Int       @map("gameweek_id")
  chipType       ChipType  @map("chip_type")
  season         String
  usedAt         DateTime  @default(now()) @map("used_at")
  /// Free Hit only: the squad's lineup before the chip, restored after the gameweek
  previousLineup Json?     @map("previous_lineup")
  revertedAt     DateTime? @map("reverted_at")

  // Relations
  squad    Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  gameweek Gameweek @relation(fields: [gameweekId], references: [id])

  @@unique([squadId, season, chipType])
  @@unique([squadId, gameweekId])
  @@map("squad_chip_usages")
}

/// A head-to-head match between two league members in a gameweek.
/// awayMemberId is null when the home member plays the league 'Average' team.
model LeagueFixture {
  id           String  @id @default(uuid())
  leagueId     String  @map("league_id")
  gameweekId   Int     @map("gameweek_id")
  homeMemberId String  @map("home_member_id")
  awayMemberId String? @map("away_member_id")
  homeScore    Int?    @map("home_score")
  awayScore    Int?    @map("away_score")
  isFinished   Boolean @default(false) @map("is_finished")

  // Relations
  league     League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  gameweek   Gameweek      @relation(fields: [gameweekId], references: [id])
  homeMember LeagueMember  @relation("HomeLeagueFixtures", fields: [homeMemberId], references: [id], onDelete: Cascade)
  awayMember LeagueMember? @relation("AwayLeagueFixtures", fields: [awayMemberId], references: [id], onDelete: Cascade)

  @@unique([leagueId, gameweekId, homeMemberId])
  @@map("league_fixtures")
}

/// Tracks Soroban RPC event indexer position and pagination cursor
model IndexerCursor {
  id         String   @id
  lastLedger Int      @map("last_ledger")
  cursor     String?
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("indexer_cursors")
}

/// Stores indexed Soroban escrow contract events for audit, reconciliation, and history
model ContractEvent {
  id         String   @id @default(uuid())
  contractId String?  @map("contract_id")
  eventType  String   @map("event_type")
  leagueId   String?  @map("league_id")
  txHash     String   @map("tx_hash")
  ledgerSeq  Int      @map("ledger_seq")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventType])
  @@index([leagueId])
  @@index([txHash])
  @@index([ledgerSeq])
  @@map("contract_events")
}

/// Tamper-evident snapshot of a database-to-chain financial reconciliation.
model LedgerAuditRun {
  id                       String   @id
  horizonLedger            Int      @map("horizon_ledger")
  sorobanLedger            Int      @map("soroban_ledger")
  indexedThroughLedger     Int      @map("indexed_through_ledger")
  expectedBalanceStroops   String   @map("expected_balance_stroops")
  observedBalanceStroops   String   @map("observed_balance_stroops")
  discrepancyStroops       String   @map("discrepancy_stroops")
  thresholdStroops         String   @map("threshold_stroops")
  findingCount             Int      @map("finding_count")
  isBalanced               Boolean  @map("is_balanced")
  previousHash             String?  @map("previous_hash")
  reportHash               String   @unique @map("report_hash")
  createdAt                DateTime @default(now()) @map("created_at")

  findings LedgerAuditFinding[]

  @@index([createdAt])
  @@map("ledger_audit_runs")
}

/// Individual, traceable discrepancy or audit coverage finding.
model LedgerAuditFinding {
  id                    String   @id @default(uuid())
  auditRunId            String   @map("audit_run_id")
  severity              String
  category              String
  message               String
  leagueId              String?  @map("league_id")
  txHash                String?  @map("tx_hash")
  ledgerSeq             Int?     @map("ledger_seq")
  expectedStroops       String?  @map("expected_stroops")
  observedStroops       String?  @map("observed_stroops")
  discrepancyStroops    String?  @map("discrepancy_stroops")
  details               Json?
  createdAt             DateTime @default(now()) @map("created_at")

  auditRun LedgerAuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)

  @@index([auditRunId, severity])
  @@index([txHash])
  @@map("ledger_audit_findings")
}

/// Tracks player price movements detected by the FPL tracking daemon
model PlayerPriceChange {
  id        Int      @id @default(autoincrement())
  playerId  Int      @map("player_id")
  fplId     Int      @map("fpl_id")
  oldPrice  Decimal  @map("old_price") @db.Decimal(4, 1)
  newPrice  Decimal  @map("new_price") @db.Decimal(4, 1)
  diff      Decimal  @db.Decimal(4, 1)
  changedAt DateTime @default(now()) @map("changed_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([changedAt])
  @@map("player_price_changes")
}

/// Tracks player injury and availability status updates detected by the FPL tracking daemon
model PlayerStatusHistory {
  id                       Int      @id @default(autoincrement())
  playerId                 Int      @map("player_id")
  fplId                    Int      @map("fpl_id")
  oldStatus                String?  @map("old_status")
  newStatus                String?  @map("new_status")
  news                     String?
  chanceOfPlayingNextRound Int?     @map("chance_of_playing_next_round")
  changedAt                DateTime @default(now()) @map("changed_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([changedAt])
  @@map("player_status_history")
}
