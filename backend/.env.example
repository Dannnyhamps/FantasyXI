# ============================================================
# FantasyXI Backend — Environment Variables Template
# ============================================================

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database — PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fantasyxi?schema=public"

# JWT Authentication
# In production, use a strong 64-byte random secret:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="7d"
# Access tokens are signed with rotating ES256 keys stored in jwt_signing_keys
# (issue #332); JWT_SECRET encrypts those private keys. Public keys are served
# at /.well-known/jwks.json. Hours between signing-key rotations (default 30 days):
JWT_KEY_ROTATION_INTERVAL_HOURS=720
# HS256 tokens issued before the ES256 rollout keep working until this ISO-8601
# time; set it to deploy time + JWT_EXPIRES_IN, leave empty to reject them.
JWT_LEGACY_HS256_UNTIL=""

# Login security (issue #331): which edge proxy's IP-geolocation headers to trust
# for impossible-travel detection. "cloudflare" (Add visitor location headers
# managed transform) or "cloudfront" (CloudFront-Viewer-Latitude/Longitude in the
# origin request policy). Leave empty when the API is not behind one of them.
GEOIP_HEADER_SOURCE=""

# Google OAuth 2.0 (Google Cloud Console credentials)
# Authorized redirect URI: http://localhost:5000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# WebAuthn / Passkeys (issue #273). The RP ID is the registrable domain the
# frontend is served from (no scheme or port); origins are the exact frontend
# origins, comma-separated. Both default to FRONTEND_URL. Changing the RP ID
# invalidates every registered passkey.
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="FantasyXI"
WEBAUTHN_ORIGINS="http://localhost:3000"

# Service-to-service API keys granting the SERVICE role (schedulers, monitoring)
# Comma-separated name:key pairs; each key must be at least 32 characters.
# Callers send the key in the X-Service-Key header.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_API_KEYS=""

# Stellar & Soroban Financial Layer (Testnet)
STELLAR_NETWORK="TESTNET"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
# Optional comma-separated Horizon backups (SDF, QuickNode, Blockdaemon, etc.).
STELLAR_HORIZON_FALLBACK_URLS=""
STELLAR_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_USDC_ASSET_CODE="USDC"
STELLAR_USDC_ISSUER="CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWUIPWIO2LEOWOHR67K"
STELLAR_TREASURY_ADDRESS="GDWZ67PEXB3P4XJ5A6M6Q7T8U9V0W1X2Y3Z4A5B6C7D8E9F0G1H2I3J4"
STELLAR_ESCROW_CONTRACT_ID="CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
# Optional fee-bump sponsor key reference; configure a remote signer to use a KMS/HSM key ID.
STELLAR_FEE_BUMP_SOURCE=""
# Optional admin key reference for automatic final-score commitments.
STELLAR_ORACLE_SIGNING_KEY=""

# Multi-region read replicas (optional; leave empty to use the primary only)
# Region of this API instance, used to pick the nearest replica
APP_REGION="eu-west-1"
# Comma-separated region=connection-string pairs of streaming read replicas
DATABASE_READ_REPLICAS=""
# e.g. DATABASE_READ_REPLICAS="eu-west-1=postgresql://reader:pass@eu-replica:5432/fantasyxi?schema=public,us-east-1=postgresql://reader:pass@us-replica:5432/fantasyxi?schema=public"
# Replicas lagging more than this are skipped until they catch up
REPLICA_MAX_LAG_MS=200
REPLICA_HEALTH_CHECK_INTERVAL_MS=1000
REPLICA_HEALTH_CHECK_TIMEOUT_MS=2000

# Redis Cache Layer (External FPL API caching)
REDIS_URL="redis://localhost:6379"
# Alternatively configure host/port/password:
# REDIS_HOST="127.0.0.1"
# REDIS_PORT=6379
# REDIS_PASSWORD=""
# REDIS_ENABLED="true"
FPL_CACHE_TTL_SECONDS=600

# Admin alerts (dropped transactions, ledger reconciliation discrepancies); both optional
ADMIN_ALERT_SLACK_WEBHOOK_URL=""
# Comma-separated recipients
ADMIN_ALERT_EMAILS=""

# Transaction coordinator: polls submitted Stellar transactions until final
TX_COORDINATOR_ENABLED="true"
TX_COORDINATOR_POLL_INTERVAL_MS=2000
TX_COORDINATOR_INITIAL_DELAY_MS=2000
TX_COORDINATOR_MAX_DELAY_MS=60000
# A hash still unknown to the network after this long is marked DROPPED
TX_COORDINATOR_MAX_PENDING_MS=900000

# Unique stable identity per running API instance for Redis Streams broadcast groups.
# FANOUT_INSTANCE_ID=api-instance-1
# Resilience tests use disposable local services, never mainnet or production DBs.
# CHAOS_DATABASE_URL=postgresql://postgres:password@localhost:55432/fantasyxi_chaos
# FANOUT_REDIS_URL=redis://localhost:56379
