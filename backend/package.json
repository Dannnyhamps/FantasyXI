{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:push": "npx prisma db push",
    "db:validate-migration": "tsx src/scripts/validateMigration.ts",
    "db:bootstrap-tenant": "psql -U postgres -d fantasyxi -f prisma/sql/tenant_bootstrap.sql",
    "db:migrate:tenants": "tsx src/scripts/multiTenantMigration.ts",
    "db:migrate:tenants:status": "tsx src/scripts/multiTenantMigration.ts --status",
    "db:migrate:tenants:retry": "tsx src/scripts/multiTenantMigration.ts --retry",
    "test": "tsx --test src/tests/tenantIsolation.test.ts src/tests/multiTenantMigration.test.ts",
    "test:tenants": "tsx --test src/tests/tenantIsolation.test.ts src/tests/multiTenantMigration.test.ts",
    "test:integration": "prisma generate && tsx --test src/tests/integration/leagueLifecycle.integration.test.ts",
    "test:testnet": "tsx --test src/tests/testnetEndToEnd.test.ts",
    "test:resilience": "tsx --test src/tests/sorobanContractClient.test.ts src/tests/financialChaos.test.ts src/tests/fanoutBackpressure.test.ts src/tests/primaryReadGuard.test.ts src/tests/readReplicaRouting.test.ts",
    "test:resilience:integration": "tsx --test src/tests/integration/financialChaos.integration.test.ts src/tests/integration/eventFanout.integration.test.ts src/tests/integration/readReplicaConsistency.integration.test.ts",
    "test:fanout:load": "tsx src/scripts/loadEventFanout.ts",
    "reconcile:ledger": "tsx src/scripts/reconcileLedger.ts",
    "db:audit-guard": "prisma db execute --file prisma/sql/financial_audit_log_append_only.sql",
    "db:benchmark-replicas": "tsx src/scripts/benchmarkReadReplicas.ts",
    "db:seed-load-test": "tsx src/scripts/seedLoadTestData.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@stellar/stellar-sdk": "^17.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "graphql": "^16.14.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg-boss": "^10.4.2",
    "ws": "^8.22.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
