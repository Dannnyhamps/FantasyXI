// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

/// Player position on the pitch — maps to FPL's element_type
enum Position {
  GKP
  DEF
  MID
  FWD
}

/// Current status of a league
enum LeagueStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Member state within a competition
enum MembershipStatus {
  PENDING
  ACTIVE
  CANCELLED
  REFUNDED
}

/// Financial lifecycle states for league entry fee payment
enum PaymentStatus {
  PENDING
  PAYMENT_INITIATED
  PAYMENT_SUBMITTED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  REFUND_PENDING
  REFUNDED
}

/// How a league is scored
enum ScoringType {
  CLASSIC
  HEAD_TO_HEAD
}

/// The season-end movement applied to a league across tier ladder boundaries.
enum LeagueTierMovement {
  STAY
  PROMOTE
  RELEGATE
}

/// FPL chips a squad can play once per season
enum ChipType {
  TRIPLE_CAPTAIN
  BENCH_BOOST
  FREE_HIT
  WILDCARD
}

/// Role-Based Access Control role assigned to a user account.
/// USER: regular platform consumer (default).
/// MODERATOR: trusted operator able to run operational maintenance (e.g. syncs).
/// ADMIN: full administrative access (platform settings, fee management).
enum UserRole {
  USER
  MODERATOR
  ADMIN
}

/// Types of USDC financial transactions
enum TransactionType {
  ENTRY_FEE
  PLATFORM_FEE
  PRIZE_PAYOUT
  REFUND
}

/// Status of a blockchain transaction
enum TransactionStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

/// Lifecycle of a payout isolated in the dead-letter queue.
/// PENDING: awaiting automatic (recoverable only) or manual retry.
/// RETRYING: claimed by a retry attempt; guards against concurrent double payouts.
/// RESOLVED: funds were delivered by a later retry.
/// DISCARDED: closed by an admin without payout (e.g. settled off-platform).
enum FailedPayoutStatus {
  PENDING
  RETRYING
  RESOLVED
  DISCARDED
}

/// Lifecycle of an on-chain transaction watched by the transaction coordinator.
/// PENDING: submitted, not yet final (getTransaction returns NOT_FOUND or the RPC is unreachable).
/// SUCCESS / FAILED: final ledger outcome reported by Soroban RPC.
/// DROPPED: never reached a ledger before the confirmation timeout; an admin is alerted.
enum CoordinatedTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  DROPPED
}

/// Financial operations recorded in the append-only audit log
enum FinancialAuditAction {
  DEPOSIT_SUBMITTED
  DEPOSIT_CONFIRMED
  DEPOSIT_FAILED
  WITHDRAWAL
  REFUND
  FEE_EXTRACTION
  PAYOUT_DEAD_LETTERED
  PAYOUT_RETRY_SUCCEEDED
  PAYOUT_RETRY_FAILED
  PAYOUT_DISCARDED
  RECONCILIATION_BALANCED
  RECONCILIATION_DISCREPANCY
}

// ============================================================
// MODELS
// ============================================================

/// A registered user on the platform.
/// Laravel equivalent: the `users` table you'd create with `php artisan make:auth`.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  username     String   @unique
  name         String?
  googleId     String?  @unique @map("google_id")
  countryCode  String?  @map("country_code")
  role         UserRole @default(USER)
  referrerId   String?  @map("referrer_id")
  referralCode String?  @unique @map("referral_code")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  wallet             Wallet?
  squads             Squad[]
  createdLeagues     League[]            @relation("LeagueCreator")
  memberships        LeagueMember[]
  transactions       Transaction[]
  referrer           User?               @relation("UserReferrals", fields: [referrerId], references: [id])
  referrees          User[]              @relation("UserReferrals")
  createdInvitations LeagueInvitation[]  @relation("InvitationCreator")
  usedInvitations    LeagueInvitation[]  @relation("InvitationUser")
  chatMessages       LeagueChatMessage[]

  @@map("users")
}

/// A Stellar wallet linked to a user for USDC payments.
/// Optional — users can use the platform without one.
model Wallet {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  stellarAddress String   @unique @map("stellar_address")
  connectedAt    DateTime @default(now()) @map("connected_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

/// A Premier League club. Data synced from the FPL API.
model Team {
  id                  Int     @id @default(autoincrement())
  fplId               Int     @unique @map("fpl_id")
  name                String
  shortName           String  @map("short_name")
  logoUrl             String? @map("logo_url")
  strength            Int?
  strengthOverallHome Int?    @map("strength_overall_home")
  strengthOverallAway Int?    @map("strength_overall_away")
  strengthAttackHome  Int?    @map("strength_attack_home")
  strengthAttackAway  Int?    @map("strength_attack_away")
  strengthDefenceHome Int?    @map("strength_defence_home")
  strengthDefenceAway Int?    @map("strength_defence_away")

  // Relations
  players      Player[]
  homeFixtures Fixture[] @relation("HomeFixtures")
  awayFixtures Fixture[] @relation("AwayFixtures")

  @@map("teams")
}

/// A real Premier League footballer. Data synced from the FPL API.
/// Like an Eloquent model with `$fillable` fields populated from an external API.
model Player {
  id                       Int      @id @default(autoincrement())
  fplId                    Int      @unique @map("fpl_id")
  firstName                String   @map("first_name")
  lastName                 String   @map("last_name")
  displayName              String   @map("display_name")
  position                 Position
  teamId                   Int      @map("team_id")
  price                    Decimal  @db.Decimal(4, 1)
  totalPoints              Int      @default(0) @map("total_points")
  minutesPlayed            Int      @default(0) @map("minutes_played")
  goalsScored              Int      @default(0) @map("goals_scored")
  assists                  Int      @default(0)
  cleanSheets              Int      @default(0) @map("clean_sheets")
  form                     Decimal? @db.Decimal(4, 1)
  status                   String?  @default("a")
  news                     String?
  chanceOfPlayingNextRound Int?     @map("chance_of_playing_next_round")
  selectedByPercent        Decimal? @map("selected_by_percent") @db.Decimal(5, 1)
  photoUrl                 String?  @map("photo_url")
  isAvailable              Boolean  @default(true) @map("is_available")
  updatedAt                DateTime @updatedAt @map("updated_at")

  // Relations
  team          Team                  @relation(fields: [teamId], references: [id])
  squadPlayers  SquadPlayer[]
  gameweekStats PlayerGameweekStats[]
  transfersIn   SquadTransfer[]       @relation("TransferIn")
  transfersOut  SquadTransfer[]       @relation("TransferOut")
  priceChanges  PlayerPriceChange[]
  statusHistory PlayerStatusHistory[]

  @@map("players")
}

/// A round of Premier League matches (38 per season).
model Gameweek {
  id         Int       @id @default(autoincrement())
  fplId      Int       @unique @map("fpl_id")
  name       String
  deadline   DateTime
  isCurrent  Boolean   @default(false) @map("is_current")
  isFinished Boolean   @default(false) @map("is_finished")
  isLocked   Boolean   @default(false) @map("is_locked")
  settledAt  DateTime? @map("settled_at")
  season     String

  // Relations
  fixtures        Fixture[]
  playerStats     PlayerGameweekStats[]
  squadScores     SquadGameweekScore[]
  transfers       SquadTransfer[]
  leaguesStarting League[]              @relation("LeagueStartGW")
  leaguesEnding   League[]              @relation("LeagueEndGW")
  chipUsages      SquadChipUsage[]
  leagueFixtures  LeagueFixture[]

  @@map("gameweeks")
}

/// A Premier League match between two clubs. Data synced from the FPL API.
model Fixture {
  id          Int       @id @default(autoincrement())
  fplId       Int       @unique @map("fpl_id")
  gameweekId  Int?      @map("gameweek_id")
  homeTeamId  Int       @map("home_team_id")
  awayTeamId  Int       @map("away_team_id")
  kickoffTime DateTime? @map("kickoff_time")
  started     Boolean   @default(false)
  finished    Boolean   @default(false)
  homeScore   Int?      @map("home_score")
  awayScore   Int?      @map("away_score")
  minutes     Int       @default(0)

  // Relations
  gameweek    Gameweek?             @relation(fields: [gameweekId], references: [id])
  homeTeam    Team                  @relation("HomeFixtures", fields: [homeTeamId], references: [id])
  awayTeam    Team                  @relation("AwayFixtures", fields: [awayTeamId], references: [id])
  playerStats PlayerGameweekStats[]

  @@map("fixtures")
}

/// How many fantasy points a player scored in a specific gameweek.
/// Like a Laravel pivot table with extra columns.
model PlayerGameweekStats {
  id          Int     @id @default(autoincrement())
  playerId    Int     @map("player_id")
  gameweekId  Int     @map("gameweek_id")
  fixtureId   Int     @map("fixture_id")
  minutes     Int     @default(0)
  goals       Int     @default(0)
  assists     Int     @default(0)
  cleanSheet  Boolean @default(false) @map("clean_sheet")
  yellowCards Int     @default(0) @map("yellow_cards")
  redCards    Int     @default(0) @map("red_cards")
  saves       Int     @default(0)
  bonus       Int     @default(0)
  totalPoints Int     @default(0) @map("total_points")

  // Relations
  player   Player   @relation(fields: [playerId], references: [id])
  gameweek Gameweek @relation(fields: [gameweekId], references: [id])
  fixture  Fixture  @relation(fields: [fixtureId], references: [id])

  @@unique([playerId, gameweekId, fixtureId])
  @@map("player_gameweek_stats")
}

/// A user's fantasy football squad.
model Squad {
  id                      String   @id @default(uuid())
  userId                  String   @map("user_id")
  name                    String
  budgetRemaining         Decimal  @default(100.0) @map("budget_remaining") @db.Decimal(5, 1)
  totalPoints             Int      @default(0) @map("total_points")
  /// Free transfers left for freeTransfersGameweekId (rolls over +1 per gameweek)
  freeTransfers           Int      @default(1) @map("free_transfers")
  freeTransfersGameweekId Int?     @map("free_transfers_gameweek_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // Relations
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  players        SquadPlayer[]
  gameweekScores SquadGameweekScore[]
  transfers      SquadTransfer[]
  memberships    LeagueMember[]
  chipUsages     SquadChipUsage[]

  @@map("squads")
}

/// A player selected in a squad — the join table between Squad and Player.
/// Tracks whether the player is starting, captain, bench order, and purchase price.
model SquadPlayer {
  id            Int     @id @default(autoincrement())
  squadId       String  @map("squad_id")
  playerId      Int     @map("player_id")
  isCaptain     Boolean @default(false) @map("is_captain")
  isViceCaptain Boolean @default(false) @map("is_vice_captain")
  isStarter     Boolean @default(true) @map("is_starter")
  positionOrder Int     @map("position_order")
  purchasePrice Decimal @map("purchase_price") @db.Decimal(4, 1)

  // Relations
  squad  Squad  @relation(fields: [squadId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  @@unique([squadId, playerId])
  @@map("squad_players")
}

/// A fantasy league created by a user.
model League {
  id              String       @id @default(uuid())
  name            String
  description     String?
  creatorId       String       @map("creator_id")
  inviteCode      String       @unique @map("invite_code")
  maxMembers      Int          @default(20) @map("max_members")
  minMembers      Int          @default(2) @map("min_members")
  currentMembers  Int          @default(0) @map("current_members")
  entryFee        Decimal      @default(0) @map("entry_fee") @db.Decimal(10, 2)
  prizePool       Decimal      @default(0) @map("prize_pool") @db.Decimal(10, 2)
  status          LeagueStatus @default(UPCOMING)
  scoringType     ScoringType  @default(CLASSIC) @map("scoring_type")
  /// Private leagues are hidden from public search and joinable only via invitation
  isPrivate       Boolean      @default(false) @map("is_private")
  startGameweekId Int          @map("start_gameweek_id")
  endGameweekId   Int          @map("end_gameweek_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  creator       User                @relation("LeagueCreator", fields: [creatorId], references: [id])
  startGameweek Gameweek            @relation("LeagueStartGW", fields: [startGameweekId], references: [id])
  endGameweek   Gameweek            @relation("LeagueEndGW", fields: [endGameweekId], references: [id])
  members       LeagueMember[]
  transactions  Transaction[]
  fixtures      LeagueFixture[]
  invitations   LeagueInvitation[]
  chatMessages  LeagueChatMessage[]
  seasons       LeagueSeason[]

  @@index([status, isPrivate])
  @@index([entryFee])
  @@index([maxMembers])
  @@map("leagues")
}

/// A ladder of leagues for a single season. Groups leagues into competitive tiers
/// so promotions and relegations can be tracked across seasons.
model LeagueTierGroup {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  season      String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tiers       LeagueTier[]
  leagueSeasons LeagueSeason[]
  placements  LeagueTierPlacement[]

  @@map("league_tier_groups")
}

/// A named tier inside a league ladder such as "Premier", "Championship" or "Division 2".
model LeagueTier {
  id                       String   @id @default(uuid())
  groupId                  String   @map("group_id")
  name                     String
  slug                     String
  rank                     Int
  description              String?
  promotionTargetTierId    String?  @map("promotion_target_tier_id")
  relegationTargetTierId   String?  @map("relegation_target_tier_id")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  group                   LeagueTierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  promotionTarget         LeagueTier? @relation("PromotionTarget", fields: [promotionTargetTierId], references: [id], onDelete: SetNull)
  relegationTarget       LeagueTier? @relation("RelegationTarget", fields: [relegationTargetTierId], references: [id], onDelete: SetNull)
  promotedFrom            LeagueTier[] @relation("PromotionTarget")
  relegatedFrom          LeagueTier[] @relation("RelegationTarget")
  leagueSeasons           LeagueSeason[]
  placements              LeagueTierPlacement[]

  @@unique([groupId, slug])
  @@unique([groupId, rank])
  @@map("league_tiers")
}

/// A league's participation in a single season, including the tier it occupies.
model LeagueSeason {
  id              String   @id @default(uuid())
  leagueId        String   @map("league_id")
  season          String
  tierGroupId     String?  @map("tier_group_id")
  tierId          String?  @map("tier_id")
  previousSeasonId String?  @map("previous_season_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  league          League           @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  tierGroup       LeagueTierGroup? @relation(fields: [tierGroupId], references: [id], onDelete: SetNull)
  tier            LeagueTier?      @relation(fields: [tierId], references: [id], onDelete: SetNull)
  previousSeason  LeagueSeason?    @relation("LeagueSeasonHistory", fields: [previousSeasonId], references: [id], onDelete: SetNull)
  nextSeason      LeagueSeason[]   @relation("LeagueSeasonHistory")
  placements      LeagueTierPlacement[]

  @@unique([leagueId, season])
  @@map("league_seasons")
}

/// Final standings snapshot used to determine a promotion or relegation event.
model LeagueTierPlacement {
  id               String            @id @default(uuid())
  leagueSeasonId    String            @map("league_season_id")
  tierId            String            @map("tier_id")
  groupId           String            @map("group_id")
  rank              Int               @default(0)
  movement          LeagueTierMovement @default(STAY)
  promotedToSeasonId String?           @map("promoted_to_season_id")
  relegatedToSeasonId String?          @map("relegated_to_season_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  leagueSeason      LeagueSeason      @relation(fields: [leagueSeasonId], references: [id], onDelete: Cascade)
  tier              LeagueTier        @relation(fields: [tierId], references: [id], onDelete: Cascade)
  group             LeagueTierGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([leagueSeasonId, groupId])
  @@map("league_tier_placements")
}

/// A user's membership in a league — links user, squad, and league together.
/// Like a Laravel pivot table: `league_user` with extra columns.
model LeagueMember {
  id             String           @id @default(uuid())
  leagueId       String           @map("league_id")
  userId         String           @map("user_id")
  squadId        String           @map("squad_id")
  status         MembershipStatus @default(PENDING)
  paymentStatus  PaymentStatus    @default(PENDING) @map("payment_status")
  stellarAddress String?          @map("stellar_address")
  joinedAt       DateTime         @default(now()) @map("joined_at")
  hasPaid        Boolean          @default(false) @map("has_paid")
  rank           Int?
  totalPoints    Int              @default(0) @map("total_points")

  // Head-to-head statistics
  matchesWon    Int @default(0) @map("matches_won")
  matchesDrawn  Int @default(0) @map("matches_drawn")
  matchesLost   Int @default(0) @map("matches_lost")
  pointsFor     Int @default(0) @map("points_for")
  pointsAgainst Int @default(0) @map("points_against")
  h2hPoints     Int @default(0) @map("h2h_points")

  // Relations
  league       League          @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id])
  squad        Squad           @relation(fields: [squadId], references: [id])
  transactions Transaction[]
  homeFixtures LeagueFixture[] @relation("HomeLeagueFixtures")
  awayFixtures LeagueFixture[] @relation("AwayLeagueFixtures")

  @@unique([leagueId, userId])
  @@index([leagueId, joinedAt, id])
  @@map("league_members")
}

/// How many points a squad scored in a specific gameweek.
model SquadGameweekScore {
  id            Int      @id @default(autoincrement())
  squadId       String   @map("squad_id")
  gameweekId    Int      @map("gameweek_id")
  points        Int      @default(0)
  benchPoints   Int      @default(0) @map("bench_points")
  captainPoints Int      @default(0) @map("captain_points")
  transferCost  Int      @default(0) @map("transfer_cost")
  calculatedAt  DateTime @default(now()) @map("calculated_at")

  // Relations
  squad    Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  gameweek Gameweek @relation(fields: [gameweekId], references: [id])

  @@unique([squadId, gameweekId])
  @@map("squad_gameweek_scores")
}

/// Audit record of a single transfer (one player out, one player in).
model SquadTransfer {
  id          Int      @id @default(autoincrement())
  squadId     String   @map("squad_id")
  gameweekId  Int      @map("gameweek_id")
  playerInId  Int      @map("player_in_id")
  playerOutId Int      @map("player_out_id")
  inPrice     Decimal  @map("in_price") @db.Decimal(4, 1)
  outPrice    Decimal  @map("out_price") @db.Decimal(4, 1)
  pointsCost  Int      @default(0) @map("points_cost")
  timestamp   DateTime @default(now())

  // Relations
  squad     Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  gameweek  Gameweek @relation(fields: [gameweekId], references: [id])
  playerIn  Player   @relation("TransferIn", fields: [playerInId], references: [id])
  playerOut Player   @relation("TransferOut", fields: [playerOutId], references: [id])

  @@index([squadId, gameweekId])
  @@map("squad_transfers")
}

/// Records USDC transactions — entry fees, prizes, deposits, withdrawals.
model Transaction {
  id            String            @id @default(uuid())
  userId        String            @map("user_id")
  leagueId      String?           @map("league_id")
  memberId      String?           @map("member_id")
  type          TransactionType
  amount        Decimal           @db.Decimal(10, 2)
  asset         String            @default("USDC")
  assetIssuer   String?           @map("asset_issuer")
  stellarTxHash String?           @map("stellar_tx_hash")
  ledgerSeq     Int?              @map("ledger_seq")
  memo          String?
  status        TransactionStatus @default(PENDING)
  confirmedAt   DateTime?         @map("confirmed_at")
  errorMessage  String?           @map("error_message")
  createdAt     DateTime          @default(now()) @map("created_at")

  // Relations
  user   User          @relation(fields: [userId], references: [id])
  league League?       @relation(fields: [leagueId], references: [id])
  member LeagueMember? @relation(fields: [memberId], references: [id])

  // A batched refund shares one Stellar hash across several members
  @@unique([stellarTxHash, memberId])
  @@map("transactions")
}

/// A chip played by a squad for a gameweek.
/// Each chip can be used once per season, and only one chip per gameweek.
model SquadChipUsage {
  id             Int       @id @default(autoincrement())
  squadId        String    @map("squad_id")
  gameweekId     Int       @map("gameweek_id")
  chipType       ChipType  @map("chip_type")
  season         String
  usedAt         DateTime  @default(now()) @map("used_at")
  /// Free Hit only: the squad's lineup before the chip, restored after the gameweek
  previousLineup Json?     @map("previous_lineup")
  revertedAt     DateTime? @map("reverted_at")

  // Relations
  squad    Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  gameweek Gameweek @relation(fields: [gameweekId], references: [id])

  @@unique([squadId, season, chipType])
  @@unique([squadId, gameweekId])
  @@map("squad_chip_usages")
}

/// A head-to-head match between two league members in a gameweek.
/// awayMemberId is null when the home member plays the league 'Average' team.
model LeagueFixture {
  id           String  @id @default(uuid())
  leagueId     String  @map("league_id")
  gameweekId   Int     @map("gameweek_id")
  homeMemberId String  @map("home_member_id")
  awayMemberId String? @map("away_member_id")
  homeScore    Int?    @map("home_score")
  awayScore    Int?    @map("away_score")
  isFinished   Boolean @default(false) @map("is_finished")
  /// True for a knockout playoff fixture generated by the end-of-season bracket,
  /// as opposed to a regular-season round-robin fixture.
  isPlayoff    Boolean @default(false) @map("is_playoff")
  /// 1-indexed knockout round (1 = first playoff round, increasing towards the final). Null outside the playoffs.
  playoffRound Int?    @map("playoff_round")
  /// 0-indexed position of this match within its playoff round, used to derive
  /// the next round's pairings (slot i plays slot i+1, in pairs) without
  /// depending on row fetch order. Null outside the playoffs.
  playoffSlot  Int?    @map("playoff_slot")

  // Relations
  league     League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  gameweek   Gameweek      @relation(fields: [gameweekId], references: [id])
  homeMember LeagueMember  @relation("HomeLeagueFixtures", fields: [homeMemberId], references: [id], onDelete: Cascade)
  awayMember LeagueMember? @relation("AwayLeagueFixtures", fields: [awayMemberId], references: [id], onDelete: Cascade)

  @@unique([leagueId, gameweekId, homeMemberId])
  @@map("league_fixtures")
}

/// Tracks Soroban RPC event indexer position and pagination cursor
model IndexerCursor {
  id         String   @id
  lastLedger Int      @map("last_ledger")
  cursor     String?
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("indexer_cursors")
}

/// Stores indexed Soroban escrow contract events for audit, reconciliation, and history
model ContractEvent {
  id         String   @id @default(uuid())
  contractId String?  @map("contract_id")
  eventType  String   @map("event_type")
  leagueId   String?  @map("league_id")
  txHash     String   @map("tx_hash")
  ledgerSeq  Int      @map("ledger_seq")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventType])
  @@index([leagueId])
  @@index([txHash])
  @@index([ledgerSeq])
  @@map("contract_events")
}

/// Tracks player price movements detected by the FPL tracking daemon
model PlayerPriceChange {
  id        Int      @id @default(autoincrement())
  playerId  Int      @map("player_id")
  fplId     Int      @map("fpl_id")
  oldPrice  Decimal  @map("old_price") @db.Decimal(4, 1)
  newPrice  Decimal  @map("new_price") @db.Decimal(4, 1)
  diff      Decimal  @db.Decimal(4, 1)
  changedAt DateTime @default(now()) @map("changed_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([changedAt])
  @@map("player_price_changes")
}

/// Tracks player injury and availability status updates detected by the FPL tracking daemon
model PlayerStatusHistory {
  id                       Int      @id @default(autoincrement())
  playerId                 Int      @map("player_id")
  fplId                    Int      @map("fpl_id")
  oldStatus                String?  @map("old_status")
  newStatus                String?  @map("new_status")
  news                     String?
  chanceOfPlayingNextRound Int?     @map("chance_of_playing_next_round")
  changedAt                DateTime @default(now()) @map("changed_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([changedAt])
  @@map("player_status_history")
}

/// Expiring invitation granting capped access to a private league.
/// Only the SHA-256 hash of the token is stored; the raw token is shown once at creation.
model LeagueInvitation {
  id          String    @id @default(uuid())
  leagueId    String    @map("league_id")
  tokenHash   String    @unique @map("token_hash")
  createdById String    @map("created_by_id")
  expiresAt   DateTime  @map("expires_at")
  maxUses     Int       @default(1) @map("max_uses")
  usesCount   Int       @default(0) @map("uses_count")
  usedAt      DateTime? @map("used_at")
  usedById    String?   @map("used_by_id")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  league    League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  createdBy User   @relation("InvitationCreator", fields: [createdById], references: [id])
  usedBy    User?  @relation("InvitationUser", fields: [usedById], references: [id])

  @@index([leagueId])
  @@map("league_invitations")
}

/// A chat message posted by a member in a league's real-time chat.
/// History is paged newest-first by (leagueId, createdAt).
model LeagueChatMessage {
  id        String   @id @default(uuid())
  leagueId  String   @map("league_id")
  userId    String   @map("user_id")
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leagueId, createdAt])
  @@map("league_chat_messages")
}

/// Dead-letter queue entry for a payout batch that failed on-chain.
/// Members referenced by an open entry are excluded from automatic dispatch so a
/// failed payout is isolated until it is retried or discarded.
model FailedPayout {
  id                 String             @id @default(uuid())
  type               TransactionType
  leagueId           String             @map("league_id")
  memberIds          String[]           @map("member_ids")
  recipients         String[]
  amountPerRecipient Decimal            @map("amount_per_recipient") @db.Decimal(10, 2)
  status             FailedPayoutStatus @default(PENDING)
  /// Recoverable errors (network, timeouts) may be retried automatically; others need an admin
  recoverable        Boolean            @default(false)
  errorMessage       String             @map("error_message")
  errorCode          Int?               @map("error_code")
  attempts           Int                @default(1)
  lastAttemptAt      DateTime           @default(now()) @map("last_attempt_at")
  resolvedAt         DateTime?          @map("resolved_at")
  resolvedById       String?            @map("resolved_by_id")
  resolutionNote     String?            @map("resolution_note")
  retryTxHash        String?            @map("retry_tx_hash")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@index([leagueId, status])
  @@map("failed_payouts")
}

/// Append-only audit trail of financial ledger operations.
/// Rows are never updated or deleted (enforced by prisma/sql/financial_audit_log_append_only.sql).
model FinancialAuditLog {
  id            String               @id @default(uuid())
  action        FinancialAuditAction
  /// User whose funds were affected; null for system-level operations
  userId        String?              @map("user_id")
  /// Who triggered the operation: a user/admin ID, or "system" for workers
  actorId       String               @map("actor_id")
  leagueId      String?              @map("league_id")
  transactionId String?              @map("transaction_id")
  amount        Decimal?             @db.Decimal(10, 2)
  asset         String?
  stellarTxHash String?              @map("stellar_tx_hash")
  metadata      Json?
  createdAt     DateTime             @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([leagueId, createdAt])
  @@index([action, createdAt])
  @@map("financial_audit_logs")
}

/// An on-chain transaction whose finality is tracked by TransactionCoordinatorService.
/// State lives here (not in memory) so polling resumes after a backend restart.
model CoordinatedTransaction {
  /// One durable signed settlement per league; never blindly resubmit after a partition.
  settlementKey String? @unique @map("settlement_key")
  id            String                       @id @default(uuid())
  txHash        String                       @unique @map("tx_hash")
  /// What the transaction does, e.g. DEPOSIT, SETTLEMENT, REFUND
  kind          String
  status        CoordinatedTransactionStatus @default(PENDING)
  userId        String?                      @map("user_id")
  leagueId      String?                      @map("league_id")
  /// Ledger row (transactions.id) to confirm or fail once the outcome is known
  transactionId String?                      @map("transaction_id")
  attempts      Int                          @default(0)
  ledgerSeq     Int?                         @map("ledger_seq")
  lastError     String?                      @map("last_error")
  metadata      Json?
  submittedAt   DateTime                     @default(now()) @map("submitted_at")
  nextPollAt    DateTime                     @default(now()) @map("next_poll_at")
  lastPolledAt  DateTime?                    @map("last_polled_at")
  finalizedAt   DateTime?                    @map("finalized_at")
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")

  @@index([status, nextPollAt])
  @@index([leagueId])
  @@map("coordinated_transactions")
}

/// Audit trail of retroactive score corrections (official FPL bonus / stat changes).
/// One row per changed entity: a player's fixture stats, a squad's gameweek score,
/// or a league member's running total.
model ScoreAdjustmentLog {
  id             String   @id @default(uuid())
  /// Groups every row written by one adjustment run
  runId          String   @map("run_id")
  gameweekId     Int      @map("gameweek_id")
  /// PLAYER_STAT | SQUAD_SCORE | LEAGUE_MEMBER
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  squadId        String?  @map("squad_id")
  leagueId       String?  @map("league_id")
  playerId       Int?     @map("player_id")
  previousPoints Int      @map("previous_points")
  delta          Int
  newPoints      Int      @map("new_points")
  reason         String
  details        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([gameweekId, createdAt])
  @@index([squadId])
  @@index([runId])
  @@map("score_adjustment_logs")
}

// ============================================================
// MULTI-TENANT SCHEMA ISOLATION
// ============================================================

/// Tenant registry: maps tenant IDs to PostgreSQL schemas.
/// Each entry represents a logical tenant (ENTERPRISE, SPONSORED, or PUBLIC tier).
/// PUBLIC tier uses the shared 'public' schema; others get dedicated schemas (tenant_<id>, sponsored_<id>).
model Tenant {
  id              String   @id @default(uuid())
  /// Tenant tier: PUBLIC (shared), ENTERPRISE (isolated), SPONSORED (isolated)
  tier            String   // TenantTier enum: PUBLIC | ENTERPRISE | SPONSORED
  /// PostgreSQL schema name (e.g., 'public', 'tenant_<uuid>', 'sponsored_<uuid>')
  schemaName      String   @unique @map("schema_name")
  /// Human-readable tenant name for logging/audit
  displayName     String   @map("display_name")
  /// Data retention period in days; respects tier quotas (default 365)
  retentionDays   Int      @default(365) @map("retention_days")
  /// Maximum leagues this tenant can create (enforced per tier)
  maxLeagues      Int      @default(100) @map("max_leagues")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  /// Soft-delete flag: false means tenant is inactive but schema is preserved
  isActive        Boolean  @default(true) @map("is_active")

  /// Audit log entries for this tenant
  securityAudits  TenantSecurityAudit[]
  /// Migration tracking for this tenant
  migrations      TenantMigration[]

  @@index([isActive])
  @@index([tier, isActive])
  @@map("tenants")
}

/// Security audit log for tenant boundary violations and suspicious activity.
/// Records cross-tenant access attempts, schema injection blocks, unauthorized tier access, etc.
model TenantSecurityAudit {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  /// User who attempted the violation (if authenticated)
  userId          String?  @map("user_id")
  /// Schema name that was attempted/blocked
  attemptedSchema String   @map("attempted_schema")
  /// Type: cross_tenant_access_attempt | invalid_schema | unauthorized_tier_access | schema_injection_blocked
  violationType   String   @map("violation_type")
  /// HTTP request path for tracing
  requestPath     String?  @map("request_path")
  createdAt       DateTime @default(now()) @map("created_at")

  /// Reference to the tenant involved
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([violationType, createdAt])
  @@map("tenant_security_audits")
}

/// Migration tracking per tenant: records which migrations have been applied to each schema.
/// Used by multiTenantMigration script to ensure idempotent, resumable migrations.
model TenantMigration {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  /// Migration name (e.g., '20240101_000000_init_tables')
  migrationName  String   @map("migration_name")
  /// When this migration was applied to the tenant's schema
  appliedAt      DateTime @default(now()) @map("applied_at")
  /// Status: success | failed | pending | rolled_back
  status         String   @default("success")
  /// Error message if status is 'failed'
  errorMessage   String?  @map("error_message")

  /// Reference to the tenant
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, migrationName])
  @@index([tenantId, appliedAt])
  @@map("tenant_migrations")
}
